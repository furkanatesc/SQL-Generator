# Sprint 32.0 — environment for docker-compose.prod.yml.
# Copy to `.env` (gitignored) and replace every placeholder. Never commit real values.
# Every ${VAR} referenced by docker-compose.prod.yml must be listed here
# (enforced by backend/tests/test_prod_compose_contract.py).

# --- Required -------------------------------------------------------------------
# API key clients send as X-API-Key (fallback when no key is stored in the DB config).
NL2SQL_API_KEY=change-me-to-a-long-random-value
# JSON array of trusted origins; must NOT contain "*" in production.
NL2SQL_CORS_ALLOW_ORIGINS='["http://localhost:8080"]'

# --- Optional -------------------------------------------------------------------
# LLM / embedding provider key (can also be set at runtime via the config API).
NVIDIA_API_KEY=
# Published host ports.
SQLGEN_BACKEND_PORT=8000
SQLGEN_FRONTEND_PORT=8080
# Tag for the locally built images (sqlgen-backend / sqlgen-frontend).
SQLGEN_IMAGE_TAG=latest
